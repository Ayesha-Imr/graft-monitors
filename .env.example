# Fill locally in .env; chmod 600 .env. Never commit credentials.
# RunPod REST v2 control plane (team-context key). Never forward to Pods.
RUNPOD_API_KEY=

# Hugging Face: model/dataset downloads and private ic-org datasets.
HF_TOKEN=

# Weights & Biases: project graft-dm-pilot.
WANDB_API_KEY=

# Cloudflare Workers AI: hosted Clef / Clef-flash monitor.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Typesafe Jev API: audit-only monitor, never in the training loop.
TYPESAFE_API_KEY=
